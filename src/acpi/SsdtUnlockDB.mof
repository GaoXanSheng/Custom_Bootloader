[WMI, 
 Dynamic, 
 Provider("WmiProv"),
 GUID("{850C1B62-A3D9-4E65-B8D5-DE3C74C9B38D}"),
 locale("MS\\0x409"),
 Description("Custom DBUnlock ACPI Interface (DBFS + misc EC/NPCF access; power-wall control is handled by firmware WMI/table replacement)")]
class CustomDbUnlock {
    [key, read] string InstanceName;
    [read] boolean Active;

    // ==========================================
    // 域 1: Dynamic Boost 开关 (DBFS)
    // ==========================================
    // 注意: _Q81/_Q82 自 2026-09-13 起保持原厂（DBFS 跟随 EC 事件），因此
    // SetDbfs 的设置会被后续 EC 事件按真实增压状态改写。
    [WmiMethodId(1), Implemented, Description("Set Dynamic Boost: 1=enable (GPU borrows to 140W, CPU may shed to 40W); 0=disable (GPU held at base TGP ~115W, CPU keeps full power). Real switch via NPCF PC02 - takes effect immediately")]
    void SetDbfs([in] uint32 Value, [out] uint32 Status);

    [WmiMethodId(2), Implemented, Description("Get DBFS Flag")]
    void GetDbfs([out] uint32 Value);

    [WmiMethodId(3), Implemented, Description("Get Bootloader Firmware Version (build epoch; table-liveness probe)")]
    void GetVersion([out] uint32 BuildVersion);

    // ==========================================
    // 域 2: 电池健康与充电上限门限 (BBHL)
    // ==========================================
    [WmiMethodId(4), Implemented, Description("Set Battery Charge Limit (e.g. 60%, 80%, 100%)")]
    void SetBatteryChargeThreshold([in] uint32 LimitPercent, [out] uint32 Status);

    [WmiMethodId(5), Implemented, Description("Get Battery Charge Limit Percent")]
    void GetBatteryChargeThreshold([out] uint32 LimitPercent);

    // ==========================================
    // 域 3: ACBT/DCBT/AMAT/AMIT 门限
    // 注意: 这四个变量在补丁后的 ASL 通道均无消费者（TGPD=TGPA、TPPD=TPPA），
    // 写入不影响实际功耗行为，仅能读回镜像值。
    // ==========================================
    [WmiMethodId(6), Implemented, Description("Set ACBT/DCBT/AMAT/AMIT (INERT: no consumer after ssdt4-tgpd-ac/tppd-ac)")]
    void SetThresholds([in] uint32 Acbt, [in] uint32 Dcbt, [in] uint32 Amat, [in] uint32 Amit, [out] uint32 Status);

    [WmiMethodId(7), Implemented, Description("Get ACBT, DCBT, AMAT, and AMIT Thresholds (mirror values only)")]
    void GetThresholds([out] uint32 Acbt, [out] uint32 Dcbt, [out] uint32 Amat, [out] uint32 Amit);

    // ==========================================
    // 域 4: EC 寄存器读写（白名单 = 固件 MIFS 0xFB00 自己写过的字段 + 功耗限值）
    // 可写 offset: 0x20 FNHK, 0x25 TOCP, 0x5F FASP, 0x9A KBNL, 0xD0 TFLG,
    //              0xD1 GFLG, 0xD2 GPMD, 0xE2 FWDE, 0xE3 BPWM, 0xE4 ITSM,
    //              0xE8 LEDM, 0xF2 DGPU, 0xF3 CPUT, 0xF4 STSM, 0xF6 CSPL,
    //              0xF7 FPPT, 0xF8 CTCL（FAAP 与 FWDE 共享字节，未暴露）
    // ==========================================
    [WmiMethodId(8), Implemented, Description("Set EC Register Byte (firmware-written whitelist; see description)")]
    void SetEcRegister([in] uint32 RegisterOffset, [in] uint32 WriteVal, [out] uint32 Status);

    [WmiMethodId(9), Implemented, Description("Get EC Register Byte (same whitelist as SetEcRegister)")]
    void GetEcRegister([in] uint32 RegisterOffset, [out] uint32 ReadVal);

    // Method 10-13 (OverrideLock/SwSmi) and 15 (GetAmdAlibDirect) removed:
    // dead implementations with no consumer. IDs remain reserved.
    // [WmiMethodId(14)] SetAmdAlibDirect retained below.

    // ==========================================
    // 域 7: AMD ALIB 固件邮箱原生子例程 (AM01~AM09 直写)
    // ==========================================
    [WmiMethodId(14), Implemented, Description("Set AMD ALIB Mailbox Command Direct (ALIB 0x0C = MODP/SMU power path)")]
    void SetAmdAlibDirect([in] uint32 SubFunction, [in] uint32 DataParam, [out] uint32 Status);

    // ==========================================
    // 域 8: Dynamic Boost 状态查询
    // ==========================================
    [WmiMethodId(16), Implemented, Description("Get Dynamic Boost State: Dbfs flag, CSPL W, FPPT W, current DB borrow cap W")]
    void GetDynamicBoost([in] uint32 Reserved, [out] uint32 Dbfs, [out] uint32 Cspl, [out] uint32 Fppt, [out] uint32 DbCapW);

    // ==========================================
    // 域 12: DB 借电上限（瓦，0..100；100=原厂。写后 Notify 0xC0 即时生效）
    // ==========================================
    [WmiMethodId(20), Implemented, Description("Set Dynamic Boost borrow cap in watts (0..100; 100=stock 140W GPU, 0=DB off). Returns 0=ok, 2=out of range")]
    void SetDbBoostCap([in] uint32 Watts, [out] uint32 Status);

    // ==========================================
    // 域 13: GPU 功耗预算（瓦，35..140；写后 Notify 0xC0 即时生效，仅性能档）
    // ==========================================
    [WmiMethodId(22), Implemented, Description("Set GPU power budget in watts (35..140; 140=stock). Performance-mode only; office keeps 60W. Returns 0=ok, 2=out of range")]
    void SetGpuBudget([in] uint32 Watts, [out] uint32 Status);

    // ==========================================
    // 域 9: 全量 EC RAM 字节读取 (0x00-0xFF)
    // ==========================================
    [WmiMethodId(17), Implemented, Description("Get Raw EC RAM Byte (full 0x00-0xFF, read-only)")]
    void GetEcByte([in] uint32 RegisterOffset, [out] uint32 ReadVal);

    // ==========================================
    // 域 10: 运行时功耗推送
    // ==========================================
    [WmiMethodId(19), Implemented, Description("Apply Power Limits: write CSPL/FPPT (0=keep) then COMM() pushes to SMU")]
    void ApplyPowerLimits([in] uint32 CsplWatts, [in] uint32 FpptWatts, [out] uint32 Status);

    // ==========================================
    // 域 11: NVPCF 驱动调用追踪（定位 Dynamic Boost CPU 钳制的执行入口）
    // ==========================================
    [WmiMethodId(21), Implemented, Description("Get NPCF driver trace: last fun#5 CUSL/CUCT values, fun#6 INC1 call count, last NCHP watts")]
    void GetNpcfTrace([out] uint32 Cusl, [out] uint32 Cuct, [out] uint32 Fun6Count, [out] uint32 LastNchp);
};
